NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider — OpenAI 사용 시
AI_API_KEY=sk-...
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Speaking 발음평가 엔진 (선택) — 미설정 시 음성 길이 기반 샌드박스 폴백으로 동작
# 둘 중 하나만 설정하면 됨. Speechace 우선, 없으면 Azure 사용.
SPEECHACE_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# 리스닝 스튜디오 데모 음원 (선택) — Supabase Storage 공개 mp3 URL 등. 미설정 시 플레이어 비활성 안내 표시.
NEXT_PUBLIC_LISTENING_SAMPLE_URL=
